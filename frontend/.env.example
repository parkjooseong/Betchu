EXPO_PUBLIC_APP_ENV=local
# Android Emulator에서는 localhost 대신 10.0.2.2를 사용합니다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# Release values must belong to your registered store apps and EAS project.
# Leave these unset for local web development. Never put server secrets in EXPO_PUBLIC_*.
BETCHU_IOS_BUNDLE_IDENTIFIER=
BETCHU_ANDROID_PACKAGE=
BETCHU_EAS_PROJECT_ID=
